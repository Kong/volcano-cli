# Local development defaults for the server started by `volcano start`.
VOLCANO_API_URL=http://localhost:8000
VOLCANO_ANON_KEY=ak-...
VOLCANO_SERVICE_KEY=sk-...
VOLCANO_DATABASE=app
GREETING=Hello from Volcano

# Browser code in a Next.js frontend reads these. Frontend builds never see
# VOLCANO_* names, so the public copies need names of their own.
NEXT_PUBLIC_VOLCANO_API_URL=http://localhost:8000
NEXT_PUBLIC_VOLCANO_ANON_KEY=ak-...
NEXT_PUBLIC_VOLCANO_DATABASE=app
